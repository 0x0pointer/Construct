# PRSec environment. Copy to .env at the repo root (git-ignored) and fill in.
#
# Two consumers read this file:
#   1. docker compose (via `make up`, which passes --env-file .env): only for ${VAR}
#      interpolation in deploy/compose/docker-compose.yml. Compose derives the in-container
#      PRSEC_* settings (DB URL, S3 endpoint, paths) itself, see section B.
#   2. prsec itself in dev mode (pydantic-settings reads ./.env, prefix PRSEC_), see section C.
#
# Generate secrets with e.g.:  openssl rand -hex 32
# Cookie secret (must be 16/24/32 bytes):  openssl rand -base64 32 | tr -- '+/' '-_'

# =============================================================== A. Deployment (compose)
PRSEC_DOMAIN=prsec.example.com
PRSEC_ACME_EMAIL=appsec@example.com
# Host directory holding work/, skills/<ver>/ + skills/current, harness/<name>/<ver>/.
# Bind-mounted into the worker and launcher at the SAME absolute path (workbenches mount by host path).
PRSEC_HOST_ROOT=/var/lib/prsec
# gid of /var/run/docker.sock on the host:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
PRSEC_IMAGE=prsec/prsec:latest
# Optional: a policy file outside the repo (path relative to deploy/compose or absolute).
# PRSEC_POLICY_FILE=/etc/prsec/policy.yaml

# Shared secret between the worker and the launcher (the only service with the Docker socket).
PRSEC_LAUNCHER_TOKEN=

# Postgres (prsec DB: queue + findings index)
PRSEC_DB_PASSWORD=

# MinIO (SARIF, transcripts). Passed to prsec as PRSEC_S3_ACCESS_KEY / PRSEC_S3_SECRET_KEY.
MINIO_ROOT_USER=prsec
MINIO_ROOT_PASSWORD=

# LLM gateway (LiteLLM). Provider keys live ONLY in the llm-gateway container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Must start with "sk-". Also given to the worker as PRSEC_GATEWAY_MASTER_KEY to mint per-scan keys.
LITELLM_MASTER_KEY=sk-
# Encrypts credentials stored in the gateway DB. Never change after first boot.
LITELLM_SALT_KEY=
# Password of the gateway's OWN Postgres (llm-gateway-db), separate from the prsec DB.
LITELLM_DB_PASSWORD=
LITELLM_LOG=INFO

# GitHub App (read-only: contents, pull requests, metadata; event: pull_request)
PRSEC_GITHUB_APP_ID=
PRSEC_GITHUB_WEBHOOK_SECRET=
PRSEC_GITHUB_API_URL=https://api.github.com
# Host path of the App's private key PEM, mounted as a compose secret.
PRSEC_GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem

# Dashboard SSO (oauth2-proxy, OIDC)
OIDC_ISSUER_URL=https://login.example.com/
OIDC_CLIENT_ID=prsec-dashboard
OIDC_CLIENT_SECRET=
# Required: only members of OIDC_ALLOWED_GROUPS (the AppSec group) may open the dashboard, whose
# triage action (tp/fp/accepted) feeds the eval corpus.
OIDC_EMAIL_DOMAINS=example.com
OIDC_ALLOWED_GROUPS=appsec
OAUTH2_PROXY_COOKIE_SECRET=

# =============================================================== B. Tunables passed through by compose
PRSEC_S3_BUCKET=prsec
PRSEC_SKILLS_VERSION=dev
PRSEC_DEBOUNCE_S=120
PRSEC_MAX_SUPERSEDES=5
PRSEC_WORKER_CONCURRENCY=4
PRSEC_RECONCILE_INTERVAL_S=900
# Enables the internal POST /scans route on prsec-api (empty = disabled).
PRSEC_ADMIN_TOKEN=
# Phase 2: registry hosts the egress proxy allows for package installs (comma-separated).
# Empty/unset = the built-in list (pypi, npm, yarn, Go proxy, Maven Central, Gradle).
# PRSEC_EGRESS_ALLOW=pypi.org,files.pythonhosted.org,registry.npmjs.org

# =============================================================== C. prsec settings reference (prsec/config.py)
# Every Settings field, with its default. In compose these are set per service and the
# values below are ignored; uncomment them for dev mode (running prsec on the host).
# PRSEC_DATABASE_URL=postgresql://prsec:prsec@localhost:5432/prsec
# PRSEC_GITHUB_APP_ID=
# PRSEC_GITHUB_PRIVATE_KEY_PATH=./deploy/compose/secrets/github-app.pem
# PRSEC_GITHUB_PRIVATE_KEY=            # inline PEM, alternative to the path
# PRSEC_GITHUB_WEBHOOK_SECRET=
# PRSEC_GITHUB_API_URL=https://api.github.com
# PRSEC_GATEWAY_URL=http://llm-gateway:4000
# PRSEC_GATEWAY_MASTER_KEY=
# PRSEC_S3_ENDPOINT=minio:9000
# PRSEC_S3_ACCESS_KEY=                 # empty -> SARIF written to a local dir instead of MinIO
# PRSEC_S3_SECRET_KEY=
# PRSEC_S3_BUCKET=prsec
# PRSEC_S3_SECURE=false
# PRSEC_RUNNER=docker                  # docker | launcher | local
# PRSEC_LAUNCHER_URL=http://launcher:8090
# PRSEC_LAUNCHER_TOKEN=
# PRSEC_WORK_ROOT=/var/lib/prsec/work
# PRSEC_SKILLS_DIR=/var/lib/prsec/skills/current
# PRSEC_SKILLS_VERSION=dev
# PRSEC_HARNESS_ROOT=/var/lib/prsec/harness
# PRSEC_POLICY_PATH=prsec/policy/policy.yaml
# PRSEC_DEBOUNCE_S=120
# PRSEC_MAX_SUPERSEDES=5
# PRSEC_WORKER_CONCURRENCY=4
# PRSEC_RECONCILE_INTERVAL_S=900

# Dev mode (LocalRunner + the harness's own login, no gateway):
# PRSEC_RUNNER=local
# PRSEC_WORK_ROOT=./work
# PRSEC_SKILLS_DIR=./prsec-skills
# PRSEC_HARNESS_ROOT=./work/harness
# PRSEC_GATEWAY_DEV_KEY=               # with no master key: passed through instead of minting keys

# Optional knobs read directly from the environment by individual modules:
# PRSEC_API_HOST=0.0.0.0
# PRSEC_API_PORT=8080
# PRSEC_SARIF_DIR=                     # local SARIF dir when S3 is not configured
# PRSEC_GATEWAY_CONTAINER=prsec-llm-gateway
# PRSEC_GATEWAY_ALIAS=llm-gateway
# PRSEC_DOCKER_RUNTIME=                # e.g. runsc (gVisor)
# PRSEC_DOCKER_MEM=4g
# PRSEC_DOCKER_CPUS=2
# PRSEC_DOCKER_PIDS=512
# PRSEC_DOCKER_TMP_SIZE=1g
# PRSEC_DOCKER_USER=                   # override workbench uid:gid (default image user 10001)
# Phase 2 dynamic environments (DockerRunner / launcher):
# PRSEC_SINK_IMAGE=                    # per-env sink image; default $PRSEC_IMAGE or prsec/prsec:latest
# PRSEC_EGRESS_CONTAINER=prsec-egress-proxy
# PRSEC_SERVICE_MEM=1g                 # memory limit of each catalog mock service
# PRSEC_SERVICE_PIDS=512
# PRSEC_SERVICE_HEALTH_S=120           # how long to wait for a mock service's health command
# PRSEC_CATALOG_PATH=                  # override prsec/dynamic/catalog.yaml (AppSec-owned)
