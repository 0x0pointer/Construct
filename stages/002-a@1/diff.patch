+<section class="page-header">
+  <p class="page-header__eyebrow">Dashboard</p>
+  <h1 class="page-header__title">Scans</h1>
+  <p class="page-header__summary">Browse scan runs, follow progress, and drill into findings, transcripts, and SARIF downloads.</p>
+</section>
+
+<section class="card stack">
+  <div class="section-heading">
+    <h2>Filter scans</h2>
+    <p class="muted">Filtering works as a plain GET form and keeps local pagination links intact.</p>
+  </div>
+  <form class="filters" method="get" action="/">
+    <label>Repo <input name="repo" value="{{ filters.repo or '' }}" placeholder="owner/name"></label>
+    <label>PR <input name="pr" value="{{ filters.pr or '' }}" size="6"></label>
+    <label>Status
+      <select name="status"><option value="">any</option>
+      {% for s in statuses %}<option {% if filters.status == s %}selected{% endif %}>{{ s }}</option>{% endfor %}
+      </select>
+    </label>
+    <div class="filters__actions">
+      <button type="submit">Apply filters</button>
+      <a class="button-secondary" href="/">Clear</a>
+    </div>
+  </form>
+</section>
+
+<section class="card">
+  <div class="section-heading">
+    <h2>Recent scans</h2>
+    <p class="muted">Findings totals are shown as total (reproduced/likely/inconclusive).</p>
+  </div>
+  <div class="table-wrap">
+    <table>
+      <thead><tr>
+        <th>#</th><th>Repo</th><th>PR</th><th>Head</th><th>Status</th><th>Triage</th>
+        <th class="num">Findings</th><th class="num">Cost</th><th class="num">Duration</th><th>Created</th>
+      </tr></thead>
+      <tbody>
+      {% for s in scans %}
+        <tr>
+          <td><a href="/scans/{{ s.id }}">{{ s.id }}</a></td>
+          <td class="wrap-anywhere">{{ s.repo }}</td>
+          <td>{{ s.pr }}</td>
+          <td><code>{{ s.head_sha[:10] }}</code></td>
+          <td><span class="badge st-{{ s.status }}">{{ s.status }}</span></td>
+          <td>{{ s.triage_decision or '-' }}</td>
+          <td class="num">{{ s.findings_total }}{% if s.findings_total %} <span class="muted">({{ s.findings_reproduced }}/{{ s.findings_likely }}/{{ s.findings_inconclusive }})</span>{% endif %}</td>
+          <td class="num">{{ s.cost_usd | usd }}</td>
+          <td class="num">{{ s.duration_s | dur }}</td>
+          <td class="muted">{{ s.created_at.strftime('%Y-%m-%d %H:%M') }}</td>
+        </tr>
+      {% endfor %}
+      </tbody>
+    </table>
+  </div>
+  {% if not scans %}
+  <div class="empty-state">
+    <p>No scans match the current filters.</p>
+    <p class="muted">Try clearing the filters or wait for the next scan to be queued.</p>
+  </div>
+  {% endif %}
+  <div class="pager">
+    {% if page > 1 %}<a href="?{{ filters | urlencode }}&page={{ page - 1 }}">&larr; newer</a>{% endif %}
+    {% if has_next %}<a href="?{{ filters | urlencode }}&page={{ page + 1 }}">older &rarr;</a>{% endif %}
+  </div>
+</section>
 {% endblock %}
