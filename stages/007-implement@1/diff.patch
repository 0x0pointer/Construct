+.tl-agent-ev:last-child { border-bottom: 0; }
+.tl-agent-ev .tl-data { grid-column: 2; }
+.tl-poller { margin-top: 0.9rem; font-size: 0.85rem; }
+.lv-debug { color: var(--muted); }
+.tl-ev.lv-warning, .tl-group .lv-warning, .tl-agent-ev.lv-warning { border-left-color: var(--warn); color: var(--warn); }
+.tl-ev.lv-error, .tl-group .lv-error, .tl-agent-ev.lv-error { border-left-color: var(--bad); color: var(--bad); }
+
+@media (max-width: 960px) {
+  .layout-two-col { grid-template-columns: 1fr; }
+  .filters { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
