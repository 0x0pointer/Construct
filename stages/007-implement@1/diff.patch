+  --crit: #b42318;
+  --high: #d97706;
+  --med: #a16207;
+  --low: #2563eb;
+  --info: #64748b;
+  --ok: #15803d;
+  --bad: #b91c1c;
+  --warn: #b45309;
+}
+
+@media (prefers-color-scheme: dark) {
