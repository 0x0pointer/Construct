+    --shadow: 0 22px 40px -30px rgba(2, 6, 23, 0.9);
+  }
+}
+
+* { box-sizing: border-box; }
+html { background: var(--bg); }
+body {
+  margin: 0;
+  background: linear-gradient(180deg, var(--panel-strong) 0, var(--bg) 200px);
+  color: var(--fg);
+  font: 14px/1.6 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
