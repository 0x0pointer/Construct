+:root {
+  color-scheme: light dark;
+  --bg: #f4f6fb;
+  --panel: #ffffff;
+  --panel-strong: #eef2ff;
+  --fg: #182033;
+  --muted: #5f6b85;
+  --line: #d7deee;
+  --accent: #3158d7;
+  --accent-strong: #2445aa;
