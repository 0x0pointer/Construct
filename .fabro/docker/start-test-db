#!/bin/sh
# Start the sandbox's Postgres (for tests marked `db`) and wait until it
# accepts connections. Safe to call more than once.
set -e
if pg_isready -q -h localhost; then
    echo "test database already running"
    exit 0
fi
service postgresql start >/dev/null
for _ in $(seq 1 30); do
    if pg_isready -q -h localhost; then
        echo "test database started"
        exit 0
    fi
    sleep 1
done
echo "test database did not start" >&2
exit 1
