#!/usr/bin/env python3
"""Give Fabro runs a title that names the issue or pull request they work on.

A run started from the web UI picks its issue (issue-to-pr) or pull request
(fix-ci) in its first step, after Fabro has already titled the run. This
watcher reads the first step's output and sets the title:

  Construct #8: construct dashboard needs to be re-styled
  Fix CI Construct: PR #11 (test)

It serves every repository on the server that uses these two workflows; the
title starts with the repository's name.

It also tidies up after runs that found nothing to do, which matters once
the automations run on a schedule: such a run is archived (hidden from the
default run list) and its empty `fabro/run/<id>` branch is deleted on GitHub.
Runs that picked an issue or pull request are never archived or pruned.

After a successful issue-to-pr run it finishes the draft pull request Fabro
opened: it puts `Closes #<issue>` at the top of the description, so merging
the pull request closes the issue, and posts the Codespaces comment.

  fabro-run-titles          keep watching (run it as a service)
  fabro-run-titles --once   look once and exit

Runs on the machine that hosts the Fabro server and talks to its local API
with the server's dev token; branches are deleted over this machine's SSH key.
GitHub calls use GITHUB_TOKEN from the environment, or else the GITHUB_TOKEN
secret in Fabro's vault (the token the runs themselves use).
State: ~/.fabro/run-titles.json (runs already handled).
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

SERVER = os.environ.get("FABRO_SERVER", "http://127.0.0.1:32276").rstrip("/") + "/api/v1"
TOKEN_FILE = os.path.expanduser("~/.fabro/storage/server.dev-token")
STATE = os.path.expanduser("~/.fabro/run-titles.json")
VAULT = os.path.expanduser("~/.fabro/storage/vaults/default/secrets.json")
GITHUB = os.environ.get("GITHUB_API", "https://api.github.com").rstrip("/")
# Workflow graph name -> the node whose output names what the run works on.
FIRST_STEP = {"IssueToPR": "check_issue", "FixCI": "pick_pr"}
MAX_TITLE = 100
# Endings of the titles this script gives to runs that ended at the first step with no work.
NOTHING_TO_DO = (": no approved issue is waiting", ": no pull request with failed checks", " to finish")
TERMINAL = ("succeeded", "failed", "cancelled", "canceled", "dead")
SCRATCH_REPO = os.path.expanduser("~/.fabro/run-titles.git")
MAX_AGE = timedelta(days=2)
CODESPACE_MARKER = "<!-- fabro-codespace -->"
DONE_CODESPACE = {"commented", "existing", "skipped old", "skipped malformed repo", "skipped malformed branch"}
DONE_ISSUE_LINK = {"linked", "existing", "skipped old", "skipped malformed repo", "skipped malformed branch"}
# The words GitHub reads in a pull request description as "merging this closes the issue".
CLOSING_WORD = r"(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)"


def api(path, body=None, method=None):
    with open(TOKEN_FILE) as f:
        token = f.read().strip()
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Authorization": "Bearer " + token, "Content-Type": "application/json"}
    req = urllib.request.Request(SERVER + path, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=30) as resp:
        content = resp.read()
    return json.loads(content) if content else None


def vault_github_token():
    try:
        with open(VAULT) as f:
            return str(json.load(f)["GITHUB_TOKEN"]["value"]).strip()
    except (OSError, ValueError, KeyError, TypeError):
        return ""


def github_api(path, body=None, method=None):
    token = os.environ.get("GITHUB_TOKEN") or vault_github_token()
    if not token:
        raise RuntimeError("GITHUB_TOKEN is not set and Fabro's vault has none")
    data = json.dumps(body).encode() if body is not None else None
    headers = {
        "Authorization": "Bearer " + token,
        "Accept": "application/vnd.github+json",
        "Content-Type": "application/json",
    }
    req = urllib.request.Request(GITHUB + path, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=30) as resp:
        content = resp.read()
    return json.loads(content) if content else None


def items(reply):
    return reply.get("data", []) if isinstance(reply, dict) else (reply or [])


def first_step_output(run_id, node):
    """Output of the node's finished command, or None while it has not finished."""
    for event in items(api(f"/runs/{run_id}/events?limit=200")):
        if event.get("event") == "command.completed" and event.get("node_id") == node:
            ref = str((event.get("properties") or {}).get("output") or "")
            if not ref.startswith("blob://"):
                return ref
            text = api(f"/runs/{run_id}/blobs/{ref.rsplit('/', 1)[-1]}")
            return text if isinstance(text, str) else json.dumps(text)
    return None


def clean(text):
    return re.sub(r"\s+", " ", "".join(c for c in text if c.isprintable())).strip()


def title_for(graph, output, repo):
    """The title for a run, from its first step's output. None leaves it alone."""
    if graph == "IssueToPR":
        picked = re.search(r"^APPROVED: issue (\d+)\b", output, re.M)
        if picked:
            name = re.search(r"^title: (.*)$", output, re.M)
            return f"{repo} #{picked.group(1)}: {clean(name.group(1)) if name else 'approved issue'}"
        waiting = re.search(r"^WAITING: issue (\d+)\b", output, re.M)
        if waiting:
            return f"{repo}: waiting for issue #{waiting.group(1)} to finish"
        if "NOTHING TO BUILD" in output:
            return f"{repo}: no approved issue is waiting"
        refused = re.search(r"^REFUSED: (.*)$", output, re.M)
        if refused:
            return f"{repo}: refused - " + clean(refused.group(1))
    if graph == "FixCI":
        picked = re.search(r"^PICKED: pull request (\d+)\b", output, re.M)
        if picked:
            checks = re.search(r"^failed checks: (.*)$", output, re.M)
            return f"Fix CI {repo}: PR #{picked.group(1)}" + (f" ({clean(checks.group(1))})" if checks else "")
        if "NOTHING TO FIX" in output:
            return f"Fix CI {repo}: no pull request with failed checks"
        refused = re.search(r"^REFUSED: (.*)$", output, re.M)
        if refused:
            return f"Fix CI {repo}: refused - " + clean(refused.group(1))
    return None


def state_title(entry):
    if isinstance(entry, dict):
        return str(entry.get("title") or "")
    return str(entry or "")


def state_codespace(entry):
    if isinstance(entry, dict):
        return str(entry.get("codespace") or "")
    return ""


def state_issue_link(entry):
    if isinstance(entry, dict):
        return str(entry.get("issue") or "")
    return ""


def set_state(state, run_id, key, status):
    entry = state.get(run_id)
    entry = dict(entry) if isinstance(entry, dict) else {"title": state_title(entry)}
    entry[key] = status
    state[run_id] = entry


def set_codespace_state(state, run_id, status):
    set_state(state, run_id, "codespace", status)


def picked_issue_number(entry):
    """The issue a run picked, read from the title this script gave it. None if it picked none."""
    picked = re.match(r"^[^:]+ #(\d+): ", state_title(entry))
    return int(picked.group(1)) if picked else None


def picked_issue_title(entry):
    return picked_issue_number(entry) is not None


def repo_parts(run):
    slug = str((run.get("repository") or {}).get("name") or "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", slug):
        return None
    return slug.split("/", 1)


def quote_path(value):
    return urllib.parse.quote(value, safe="")


def codespace_url(repo_id, branch):
    repo_id = str(repo_id)
    if not repo_id.isdigit():
        raise ValueError("repository id is not numeric")
    return "https://github.com/codespaces/new?" + urllib.parse.urlencode({"repo": repo_id, "ref": branch})


def codespace_comment_body(repo_id, branch):
    url = codespace_url(repo_id, branch)
    return (
        CODESPACE_MARKER
        + "\n"
        + f"[![Open in GitHub Codespaces](https://github.com/codespaces/badge.svg)]({url})\n\n"
        + "Open this PR branch in GitHub Codespaces to test the application changes before review."
    )


def find_open_pr(owner, repo, branch):
    head = quote_path(f"{owner}:{branch}")
    path = f"/repos/{quote_path(owner)}/{quote_path(repo)}/pulls?state=open&head={head}&per_page=10"
    prs = items(github_api(path))
    return prs[0] if prs else None


def existing_codespace_comment(owner, repo, number):
    base = f"/repos/{quote_path(owner)}/{quote_path(repo)}/issues/{number}/comments?per_page=100"
    page = 1
    while True:
        path = base if page == 1 else base + f"&page={page}"
        comments = items(github_api(path))
        if any(CODESPACE_MARKER in str(c.get("body") or "") for c in comments):
            return True
        if len(comments) < 100:
            return False
        page += 1


def add_codespace_comment(run):
    """Add the Codespaces PR comment for a successful IssueToPR run, if ready.

    Returns a done status string, or None when a later sweep should retry.
    """
    run_id = str(run.get("id") or "")
    parts = repo_parts(run)
    if not parts:
        print(f"{run_id}: cannot add codespace comment for malformed repository name", file=sys.stderr, flush=True)
        return "skipped malformed repo"
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", run_id):
        print(f"{run_id}: cannot add codespace comment for malformed run id", file=sys.stderr, flush=True)
        return "skipped malformed branch"
    owner, repo = parts
    branch = f"fabro/run/{run_id}"
    pr = find_open_pr(owner, repo, branch)
    if not pr:
        print(f"{run_id}: pull request for {branch} is not visible yet", file=sys.stderr, flush=True)
        return None
    number = pr.get("number")
    if not number:
        print(f"{run_id}: pull request for {branch} has no number", file=sys.stderr, flush=True)
        return None
    if existing_codespace_comment(owner, repo, number):
        print(f"{run_id}: codespace comment already exists on PR #{number}", flush=True)
        return "existing"
    repo_info = github_api(f"/repos/{quote_path(owner)}/{quote_path(repo)}")
    body = codespace_comment_body((repo_info or {}).get("id"), branch)
    path = f"/repos/{quote_path(owner)}/{quote_path(repo)}/issues/{number}/comments"
    github_api(path, body={"body": body}, method="POST")
    print(f"{run_id}: added codespace comment to PR #{number}", flush=True)
    return "commented"


def closes_issue(text, issue):
    """Whether a pull request description already says that merging it closes the issue."""
    return bool(re.search(rf"\b{CLOSING_WORD}:?\s+#{issue}\b", text or "", re.I))


def link_issue(run, issue):
    """Put `Closes #<issue>` in the description of the run's pull request, if ready.

    GitHub then lists the issue on the pull request and closes it when the pull
    request is merged. Returns a done status string, or None when a later sweep
    should retry.
    """
    run_id = str(run.get("id") or "")
    parts = repo_parts(run)
    if not parts:
        print(f"{run_id}: cannot link the issue for malformed repository name", file=sys.stderr, flush=True)
        return "skipped malformed repo"
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", run_id):
        print(f"{run_id}: cannot link the issue for malformed run id", file=sys.stderr, flush=True)
        return "skipped malformed branch"
    owner, repo = parts
    pr = find_open_pr(owner, repo, f"fabro/run/{run_id}")
    number = (pr or {}).get("number")
    if not number:
        return None
    body = str(pr.get("body") or "")
    if closes_issue(body, issue):
        print(f"{run_id}: PR #{number} already closes issue #{issue}", flush=True)
        return "existing"
    path = f"/repos/{quote_path(owner)}/{quote_path(repo)}/pulls/{number}"
    github_api(path, body={"body": f"Closes #{issue}\n\n{body}".rstrip() + "\n"}, method="PATCH")
    print(f"{run_id}: PR #{number} now closes issue #{issue}", flush=True)
    return "linked"


def tidy(run):
    """Archive a finished run that had nothing to do and delete its empty branch."""
    run_id = run["id"]
    api(f"/runs/{run_id}/archive", method="POST")
    slug = str((run.get("repository") or {}).get("name") or "")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", slug):
        return "archived"
    if not os.path.isdir(SCRATCH_REPO):
        subprocess.run(["git", "init", "-q", "--bare", SCRATCH_REPO], check=True)
    pushed = subprocess.run(
        ["git", "-C", SCRATCH_REPO, "push", "-q", f"git@github.com:{slug}.git", "--delete", f"refs/heads/fabro/run/{run_id}"],
        capture_output=True, text=True, timeout=60,
        env=dict(os.environ, GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new"))
    # A branch that is already gone is fine.
    return "archived, branch deleted" if pushed.returncode == 0 else "archived"


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return {}


def save_state(state):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


def sweep(state):
    """Title every recent run that has finished its first step. Returns the number changed."""
    changed = 0
    cutoff = datetime.now(timezone.utc) - MAX_AGE
    for run in items(api("/runs?page%5Blimit%5D=50")):
        run_id = run.get("id")
        graph = (run.get("workflow") or {}).get("graph_name")
        status = ((run.get("lifecycle") or {}).get("status") or {}).get("kind")
        if run_id and state_title(state.get(run_id)).endswith(NOTHING_TO_DO) and status in TERMINAL:
            try:
                state[run_id] = tidy(run)
                print(f"{run_id}: {state[run_id]}", flush=True)
            except Exception as exc:
                print(f"{run_id}: could not tidy up: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
                state[run_id] = "tidy failed"
            continue
        if not run_id or graph not in FIRST_STEP:
            continue
        created = str((run.get("timestamps") or {}).get("created_at") or "")
        old = False
        try:
            old = datetime.fromisoformat(created.replace("Z", "+00:00")) < cutoff
        except ValueError:
            pass
        if not state_title(state.get(run_id)):
            if old:
                state[run_id] = "old"
                continue
            output = first_step_output(run_id, FIRST_STEP[graph])
            if output is None:
                if status in TERMINAL:
                    state[run_id] = "no first step"
                continue
            repo = str((run.get("repository") or {}).get("name") or "").rsplit("/", 1)[-1] or "run"
            title = title_for(graph, output, clean(repo))
            if title:
                title = title[:MAX_TITLE].strip()
                api(f"/runs/{run_id}", body={"title": title}, method="PATCH")
                print(f"{run_id}: {title}", flush=True)
                changed += 1
            state[run_id] = title or "unrecognised output"
        issue = picked_issue_number(state.get(run_id))
        if graph != "IssueToPR" or status != "succeeded" or issue is None:
            continue
        if state_issue_link(state.get(run_id)) not in DONE_ISSUE_LINK:
            link_status = "skipped old" if old else None
            if not old:
                try:
                    link_status = link_issue(run, issue)
                except Exception as exc:
                    print(f"{run_id}: could not link issue #{issue}: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
            if link_status:
                set_state(state, run_id, "issue", link_status)
                changed += 1
        if state_codespace(state.get(run_id)) not in DONE_CODESPACE:
            if old:
                set_codespace_state(state, run_id, "skipped old")
                print(f"{run_id}: skipped codespace comment for old run", file=sys.stderr, flush=True)
                changed += 1
                continue
            try:
                comment_status = add_codespace_comment(run)
            except Exception as exc:
                print(f"{run_id}: could not add codespace comment: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
                comment_status = None
            if comment_status:
                set_codespace_state(state, run_id, comment_status)
                changed += 1
    # Forget runs the server no longer lists among its recent ones.
    for run_id in sorted(state)[:-500]:
        del state[run_id]
    return changed


def main():
    parser = argparse.ArgumentParser(description="Title Fabro runs after the issue or PR they picked.")
    parser.add_argument("--once", action="store_true", help="look once and exit")
    parser.add_argument("--interval", type=float, default=5.0, help="seconds between looks (default 5)")
    args = parser.parse_args()
    state = load_state()
    while True:
        before = dict(state)
        try:
            sweep(state)
        except Exception as exc:  # the server may be restarting; keep watching
            print(f"could not reach the Fabro server: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
        if state != before:
            save_state(state)
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main())
