# Host-side environment for the local pilot (worker, dashboard, prsec-eval) with the Docker runner
# and the Spark gateway from deploy/compose/docker-compose.local.yml. Sourced by bash in the
# `make local-*` and `make eval` targets, which set PRSEC_LOCAL_ROOT to the repo root: DockerRunner
# bind-mounts these dirs into workbenches, so they must be absolute host paths.
# No secrets: the dev key only exists on this machine's gateway.
PRSEC_DATABASE_URL=postgresql://prsec:prsec@localhost:55433/prsec
PRSEC_RUNNER=docker
PRSEC_POLICY_PATH=${PRSEC_LOCAL_ROOT}/policy-spark.yaml
PRSEC_WORK_ROOT=${PRSEC_LOCAL_ROOT}/work/local
PRSEC_SKILLS_DIR=${PRSEC_LOCAL_ROOT}/prsec-skills
PRSEC_SKILLS_VERSION=local
PRSEC_HARNESS_ROOT=${PRSEC_LOCAL_ROOT}/work/harness
PRSEC_SARIF_DIR=${PRSEC_LOCAL_ROOT}/work/local/sarif
# Workbenches reach the gateway by its alias on the scan network. No master key: the worker mints
# no per-task keys, it passes the dev key through.
PRSEC_GATEWAY_URL=http://llm-gateway:4000
PRSEC_GATEWAY_DEV_KEY=sk-prsec-local
PRSEC_GATEWAY_MASTER_KEY=
PRSEC_S3_ACCESS_KEY=
PRSEC_SINK_IMAGE=prsec/prsec:latest
PRSEC_EGRESS_CONTAINER=prsec-egress-proxy
PRSEC_WORKER_CONCURRENCY=2
PRSEC_DEBOUNCE_S=0
# No GitHub App here: eval scans are queued by prsec-eval, so the reconciler has nothing to do.
PRSEC_RECONCILE_INTERVAL_S=86400
PRSEC_DASHBOARD_PORT=8081
